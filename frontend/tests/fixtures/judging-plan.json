              "additionalProperties": false,
              "properties": {
                "finding_id": {
                  "title": "Finding Id",
                  "type": "string"
                },
                "polarity": {
                  "enum": [
                    "positive",
                    "negative"
                  ],
                  "title": "Polarity",
                  "type": "string"
                },
                "observation": {
                  "title": "Observation",
                  "type": "string"
                },
                "evidence_ids": {
                  "items": {
                    "type": "string"
                  },
                  "title": "Evidence Ids",
                  "type": "array"
                }
              },
              "required": [
                "finding_id",
                "polarity",
                "observation",
                "evidence_ids"
              ],
              "title": "WindowFinding",
              "type": "object"
            }
          },
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1,
              "title": "Schema Version",
              "type": "integer"
            },
            "window_id": {
              "title": "Window Id",
              "type": "string"
            },
            "findings": {
              "items": {
                "$ref": "#/$defs/WindowFinding"
              },
              "maxItems": 4,
              "title": "Findings",
              "type": "array"
            }
          },
          "required": [
            "schema_version",
            "window_id",
            "findings"
          ],
          "title": "WindowFindings",
          "type": "object"
        }
      },
      "merge": {
        "name": "merged_verdict",
        "schema": {
          "$defs": {
            "BehavioralFeedback": {
              "additionalProperties": false,
              "properties": {
                "success": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Success"
                },
                "problem": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Problem"
                },
                "desired_behavior": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Desired Behavior"
                }
              },
              "required": [
                "success",
                "problem",
                "desired_behavior"
              ],
              "title": "BehavioralFeedback",
              "type": "object"
            }
          },
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1,
              "title": "Schema Version",
              "type": "integer"
            },
            "status": {
              "enum": [
                "scored",
                "insufficient_evidence"
              ],
              "title": "Status",
              "type": "string"
            },
            "score": {
