  "protocol": {
    "protocol_version": "2",
    "prompt_templates": {
      "digest_system": "PHASE: digest\nCreate a rubric-neutral factual digest of the supplied raw chunk. Preserve important actions, results, omissions, corrections, and constraints. Cite only allowed evidence IDs. Return the requested JSON.",
      "digest_user": "EXPECTED_CHUNK_ID: {chunk_id}\nEXAMPLE_EVIDENCE_ID: {example_evidence_id}\nALLOWED_EVIDENCE_IDS: {allowed_evidence_ids}\nRAW_CHUNK:\n{raw_text}",
      "window_system": "PHASE: window\n{rubric_system}\nReturn bounded findings, not a score. Cite only evidence IDs visible in the active raw window.",
      "window_user": "EXPECTED_WINDOW_ID: {window_id}\nEXAMPLE_EVIDENCE_ID: {example_evidence_id}\nALLOWED_FINDING_EVIDENCE_IDS: {allowed_evidence_ids}\nRUBRIC_CRITERIA:\n{rubric_criteria}\n{sections}",
      "merge_system": "PHASE: merge\n{rubric_system}\nReturn one anchored session verdict with evidence-cited behavioral feedback.",
      "merge_user": "COVERAGE_MANIFEST: {coverage_manifest}\nORDERED_CHUNK_DIGESTS: {digest_context}\nORDERED_DEDUPLICATED_FINDINGS: {finding_context}\nALLOWED_EVIDENCE_IDS: {allowed_evidence_ids}\nRUBRIC_CRITERIA:\n{rubric_criteria}"
    },
    "schemas": {
      "digest": {
        "name": "chunk_digest",
        "schema": {
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1,
              "title": "Schema Version",
              "type": "integer"
            },
            "chunk_id": {
              "title": "Chunk Id",
              "type": "string"
            },
            "text": {
              "title": "Text",
              "type": "string"
            },
            "evidence_ids": {
              "items": {
                "type": "string"
              },
              "title": "Evidence Ids",
              "type": "array"
            }
          },
          "required": [
            "schema_version",
            "chunk_id",
            "text",
            "evidence_ids"
          ],
          "title": "ChunkDigest",
          "type": "object"
        }
      },
      "window": {
