                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Score"
            },
            "rationale": {
              "title": "Rationale",
              "type": "string"
            },
            "evidence_ids": {
              "items": {
                "type": "string"
              },
              "title": "Evidence Ids",
              "type": "array"
            },
            "feedback": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BehavioralFeedback"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "schema_version",
            "status",
            "score",
            "rationale",
            "evidence_ids",
            "feedback"
          ],
          "title": "MergedVerdict",
          "type": "object"
        }
      }
